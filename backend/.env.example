DATABASE_URL=postgresql+psycopg2://username:password@host:5432/database?sslmode=require
FRONTEND_URL=https://email-automation-umber-tau.vercel.app/
CORS_ORIGINS=["https://email-automation-umber-tau.vercel.app"]
SEED_INITIAL_EMPLOYEES=false

# SMTP / Email Service Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Task Automation
SMTP_USE_TLS=true

ENABLE_EMAIL_WORKER=false
