DATABASE_URL=sqlite:///./belvo.db
FRONTEND_URL=http://localhost:5173
SEED_INITIAL_EMPLOYEES=false

# SMTP / Email Service Configuration (Optional)
# If left blank, POST /api/tasks/{id}/send returns a 503 configuration error instead of pretending an email was sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=task Automation
SMTP_USE_TLS=true

ENABLE_EMAIL_WORKER=false
