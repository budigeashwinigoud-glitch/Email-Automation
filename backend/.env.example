DATABASE_URL=sqlite:///./belvo.db
FRONTEND_URL=http://localhost:5173
SEED_INITIAL_EMPLOYEES=false

# SMTP / Email Service Configuration (Optional)
# If left blank, POST /api/tasks/{id}/send returns a 503 configuration error instead of pretending an email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Belvo HR Task Management
SMTP_USE_TLS=true
